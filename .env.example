# .env.example — 环境变量清单（Phase 1-4）
# 复制为 .env 使用（.env 已被 .gitignore 忽略）
# 密钥只放这里，禁止入库 / 入日志 / 入 Prompt / 入 git

# ---- App ----
TESTPLATFORM_APP_DEBUG=false
TESTPLATFORM_APP_HOST=0.0.0.0
TESTPLATFORM_APP_PORT=8000
TESTPLATFORM_APP_DOCS_ENABLED=true       # Swagger UI /docs 开关（生产设 false 即关，§10.5）

# ---- Database ----
# 开发用 SQLite；生产改为: postgresql://user:pass@host:5432/dbname
TESTPLATFORM_DATABASE_URL=sqlite:///./data/platform.db

# ---- Redis ----
TESTPLATFORM_REDIS_HOST=127.0.0.1
TESTPLATFORM_REDIS_PORT=6379
# 占位符：请按实际 Redis requirepass 填写到本地 .env（禁止把真实密码提交 git）
TESTPLATFORM_REDIS_PASSWORD=your_redis_password
TESTPLATFORM_REDIS_DB=0
TESTPLATFORM_REDIS_SOCKET_TIMEOUT=2.0       # 健康检查探测超时（秒）

# ---- Celery ----
# Windows 本地 worker 必须 --pool=solo（见 scripts/start_worker.bat）
TESTPLATFORM_CELERY_SOFT_TIME_LIMIT=300
TESTPLATFORM_CELERY_TIME_LIMIT=360
TESTPLATFORM_CELERY_RESULT_EXPIRES=3600       # result backend 仅短期状态，存活时长

# ---- Execution ----
# 被测接口 base_url（写死；演示默认 httpbin.org，本地联调可改成内网服务）
TESTPLATFORM_EXECUTION_BASE_URL=http://httpbin.org
TESTPLATFORM_EXECUTION_PYTEST_TIMEOUT=300

# ---- Swagger（Phase 2 影响分析）----
TESTPLATFORM_SWAGGER_MAX_UPLOAD_BYTES=2000000          # 文档大小上限（超限拒绝解析）
TESTPLATFORM_SWAGGER_HASH_VERSION=1                    # 哈希算法版本（升级递增）
TESTPLATFORM_SWAGGER_MAX_OPERATION_IDS_WARN=200        # operation 数告警阈值（只 warning 继续入库）

# ---- LLM（Phase 3 AI 生成）----
# DeepSeek API key（密钥只放 .env，禁止入库/入日志/入 prompt/入 git）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
TESTPLATFORM_LLM_BASE_URL=https://api.deepseek.com     # OpenAI 兼容协议
TESTPLATFORM_LLM_MODEL=deepseek-chat
TESTPLATFORM_LLM_TEMPERATURE=0                         # 确定性，可复现
TESTPLATFORM_LLM_MAX_TOKENS=4096
TESTPLATFORM_LLM_MAX_INPUT_CHARS=50000                 # 输入长度预检阈值（超限拒绝，§9.3）
TESTPLATFORM_LLM_CONNECT_TIMEOUT=5                     # 连接超时（秒）
TESTPLATFORM_LLM_READ_TIMEOUT=60                       # 读超时（秒）
TESTPLATFORM_LLM_MAX_RETRIES=3                         # 瞬时异常重试次数
TESTPLATFORM_LLM_RETRY_BACKOFF=1                       # 指数退避基数（秒）
TESTPLATFORM_LLM_COST_PER_1K_TOKENS=0.001              # 成本估算单价（demo 均价）
TESTPLATFORM_LLM_TASK_SOFT_TIMEOUT_SECONDS=540         # 生成任务软超时（捕获落 FAILED）
TESTPLATFORM_LLM_TASK_TIMEOUT_SECONDS=600              # 生成任务硬超时

# ---- Security（Phase 4 Bearer Token 鉴权）----
# dev 默认仅供本地演示；生产必须覆盖（§3.1 禁写死密钥）
TESTPLATFORM_SECURITY_API_TOKEN=testplatform-dev-token

# ---- Frontend（Phase 4 CORS 白名单，MVP 零前端默认空）----
# 前端做时填来源，如 TESTPLATFORM_FRONTEND_CORS_ORIGINS=["http://localhost:5173"]
