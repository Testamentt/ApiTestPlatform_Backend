# .env.example — 环境变量清单（Phase 1）
# 复制为 .env 使用（.env 已被 .gitignore 忽略）
# 密钥只放这里，禁止入库 / 入日志 / 入 Prompt / 入 git
# Phase 2+ 再加回：TESTPLATFORM_LLM_* / DEEPSEEK_API_KEY / TESTPLATFORM_API_TOKEN / CORS / FRONTEND

# ---- App ----
TESTPLATFORM_APP_DEBUG=false
TESTPLATFORM_APP_HOST=0.0.0.0
TESTPLATFORM_APP_PORT=8000

# ---- Database ----
# 开发用 SQLite；生产改为: postgresql://user:pass@host:5432/dbname
TESTPLATFORM_DATABASE_URL=sqlite:///./data/platform.db

# ---- Redis ----
TESTPLATFORM_REDIS_HOST=127.0.0.1
TESTPLATFORM_REDIS_PORT=6379
# 本机 Redis requirepass（示例值，请按实际填写，勿提交真实密码）
TESTPLATFORM_REDIS_PASSWORD=1234abcd
TESTPLATFORM_REDIS_DB=0

# ---- Celery ----
# Windows 本地 worker 必须 --pool=solo（见 scripts/start_worker.bat）
TESTPLATFORM_CELERY_SOFT_TIME_LIMIT=300
TESTPLATFORM_CELERY_TIME_LIMIT=360

# ---- Execution ----
# 被测接口 base_url（写死；演示默认 httpbin.org，本地联调可改成内网服务）
TESTPLATFORM_EXECUTION_BASE_URL=http://httpbin.org
TESTPLATFORM_EXECUTION_PYTEST_TIMEOUT=300
