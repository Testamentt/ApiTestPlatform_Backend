# .env.example — 环境变量清单
# 复制为 .env 使用（.env 已被 .gitignore 忽略）
# 密钥只放这里，禁止入库 / 入日志 / 入 Prompt / 入 git

# ---- App ----
TESTPLATFORM_APP_DEBUG=false
TESTPLATFORM_APP_HOST=0.0.0.0
TESTPLATFORM_APP_PORT=8000
# 前端来源白名单（Vue 开发服务器）；生产同源托管则留空；禁止 '*'
TESTPLATFORM_APP_CORS_ORIGINS=http://localhost:5173

# ---- Database ----
# 开发用 SQLite；生产改为: postgresql://user:pass@host:5432/dbname
TESTPLATFORM_DATABASE_URL=sqlite:///./data/platform.db

# ---- Redis ----
TESTPLATFORM_REDIS_HOST=127.0.0.1
TESTPLATFORM_REDIS_PORT=6379
# 本机 Redis requirepass（示例值，请按实际填写，勿提交真实密码）
TESTPLATFORM_REDIS_PASSWORD=1234abcd
TESTPLATFORM_REDIS_DB=0

# ---- Celery ----
# Windows 本地必须 solo；生产可 prefork --concurrency=4
TESTPLATFORM_CELERY_WORKER_POOL=solo
TESTPLATFORM_CELERY_CONCURRENCY=1

# ---- LLM（密钥必填）----
# 默认 DeepSeek；改 base_url 即切通义（https://dashscope.aliyuncs.com/compatible-mode/v1）
TESTPLATFORM_LLM_BASE_URL=https://api.deepseek.com
TESTPLATFORM_LLM_MODEL_CHAIN=deepseek-chat
TESTPLATFORM_LLM_TEMPERATURE=0.0
# ★ 你的 DeepSeek API Key（plats 平台申请）
DEEPSEEK_API_KEY=

# ---- Security（MVP 鉴权）----
TESTPLATFORM_API_TOKEN=

# ---- Frontend（Vue 前后端分离）----
TESTPLATFORM_FRONTEND_DEV_PORT=5173                  # Vite 开发端口
TESTPLATFORM_FRONTEND_PROXY_TARGET=http://127.0.0.1:8000   # 开发代理目标（FastAPI）
