# 本项目编码格式：UTF-8（无 BOM）。
# .env.example — 环境变量清单（Phase 1-4）
# 复制为 .env 使用（.env 已被 .gitignore 忽略）
# 密钥只放这里，禁止入库 / 入日志 / 入 Prompt / 入 git

# ---- App ----
TESTPLATFORM_APP_DEBUG=false
TESTPLATFORM_APP_HOST=0.0.0.0
TESTPLATFORM_APP_PORT=8000
TESTPLATFORM_APP_DOCS_ENABLED=true       # Swagger UI /docs 开关（生产设 false 即关）

# ---- Database ----
# 开发用 SQLite；生产改为: postgresql://user:pass@host:5432/dbname
TESTPLATFORM_DATABASE_URL=sqlite:///./data/platform.db

# ---- Redis ----
TESTPLATFORM_REDIS_HOST=127.0.0.1
TESTPLATFORM_REDIS_PORT=6379
# 占位符：请按实际 Redis requirepass 填写到本地 .env（禁止把真实密码提交 git）
TESTPLATFORM_REDIS_PASSWORD=your_redis_password
TESTPLATFORM_REDIS_DB=0
TESTPLATFORM_REDIS_SOCKET_TIMEOUT=2.0       # 健康检查探测超时（秒）

# ---- Celery ----
# Windows 本地 worker 必须 --pool=solo（见 scripts/start_worker.bat）
TESTPLATFORM_CELERY_SOFT_TIME_LIMIT=300
TESTPLATFORM_CELERY_TIME_LIMIT=360
TESTPLATFORM_CELERY_RESULT_EXPIRES=3600       # result backend 仅短期状态，存活时长
TESTPLATFORM_CELERY_PENDING_TIMEOUT=600       # PENDING 孤儿基础宽限（秒）：入队却无人领取超此时长即回收为 failed；
                                              # 实际值按队列位置叠加前序任务的 timeout_seconds（solo 串行排队不算孤儿）
TESTPLATFORM_CELERY_STALE_SCAN_INTERVAL=60    # 僵尸回收扫描周期（秒，Celery Beat）；0=关闭周期扫描
TESTPLATFORM_CELERY_QUEUE=testplatform        # 队列名=环境命名空间：多环境同机共用 Redis 时改此值隔离消息

# ---- Execution ----
# 被测接口 base_url：默认本地 mock（先 python scripts/mock_target.py 拉起）全离线稳定；
# ERP 演示（管伊佳ERP，需先起被测系统）改：http://127.0.0.1:9999/jshERP-boot
TESTPLATFORM_EXECUTION_BASE_URL=http://127.0.0.1:9999
TESTPLATFORM_EXECUTION_PYTEST_TIMEOUT=300
# 执行器：local=平台子进程跑 pytest（默认）；jenkins=投递 Jenkins 并回读 JUnit（见下方 Jenkins 段）
TESTPLATFORM_EXECUTION_EXECUTOR=local
# 被测系统登录凭证（execution.auth_enabled 时执行层使用；密钥只放 .env）
# 鉴权开关/登录体模板在 config/settings.yaml 的 execution.auth_* 段（登录体是 dict，不支持 env 覆盖）
ERP_TEST_USERNAME=jsh
ERP_TEST_PASSWORD=your_erp_password

# ---- Jenkins 集成（execution.executor=jenkins 时使用）----
# 平台只投递构建与回读 JUnit，不在平台侧保存 Jenkins 凭据；token 只放 .env
TESTPLATFORM_JENKINS_BASE_URL=http://127.0.0.1:8080
TESTPLATFORM_JENKINS_USERNAME=admin
TESTPLATFORM_JENKINS_JOB_NAME=testplatform-cases
TESTPLATFORM_JENKINS_ARTIFACT_PATH=reports/junit.xml
TESTPLATFORM_JENKINS_POLL_INTERVAL_SECONDS=5
# API Token（Jenkins → 用户 → Configure → API Token → Add new Token）
JENKINS_API_TOKEN=your-jenkins-api-token

# ---- Swagger（Phase 2 影响分析）----
TESTPLATFORM_SWAGGER_MAX_UPLOAD_BYTES=2000000          # 文档大小上限（超限拒绝解析）
TESTPLATFORM_SWAGGER_HASH_VERSION=2                    # 哈希算法版本（2=sha256 指纹）
TESTPLATFORM_SWAGGER_MAX_OPERATION_IDS_WARN=200        # operation 数告警阈值（只 warning 继续入库）

# ---- LLM（Phase 3 AI 生成）----
# key 与 base_url/model 解耦：任意 OpenAI 兼容端点均可，例如
#   DeepSeek 官方：base_url=https://api.deepseek.com  model=deepseek-chat
#   CommandCode  ：base_url=https://api.commandcode.ai/provider/v1  model=deepseek/deepseek-v4.1-flash
# 密钥只放 .env，禁止入库/入日志/入 prompt/入 git
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
TESTPLATFORM_LLM_BASE_URL=https://api.deepseek.com     # OpenAI 兼容协议
TESTPLATFORM_LLM_MODEL=deepseek-chat
TESTPLATFORM_LLM_TEMPERATURE=0                         # 确定性，可复现
TESTPLATFORM_LLM_MAX_TOKENS=4096
TESTPLATFORM_LLM_MAX_INPUT_CHARS=50000                 # 输入长度预检阈值（超限拒绝）
TESTPLATFORM_LLM_CONNECT_TIMEOUT=5                     # 连接超时（秒）
TESTPLATFORM_LLM_READ_TIMEOUT=60                       # 读超时（秒）
TESTPLATFORM_LLM_MAX_RETRIES=3                         # 瞬时异常重试次数
TESTPLATFORM_LLM_RETRY_BACKOFF=1                       # 指数退避基数（秒）
TESTPLATFORM_LLM_COST_PER_1K_TOKENS=0.001              # 成本估算单价（demo 均价）
TESTPLATFORM_LLM_TASK_SOFT_TIMEOUT_SECONDS=540         # 生成任务软超时（捕获落 FAILED）
TESTPLATFORM_LLM_TASK_TIMEOUT_SECONDS=600              # 生成任务硬超时

# ---- Security（Bearer Token 鉴权 + 可选加固）----
# dev 默认仅供本地演示；生产必须覆盖（禁止写死密钥）
TESTPLATFORM_SECURITY_API_TOKEN=testplatform-dev-token
# JWT 通道：留空=关闭（只认静态 token）；填入 HS256 密钥后额外接受带 exp 的 JWT
TESTPLATFORM_SECURITY_JWT_SECRET=
TESTPLATFORM_SECURITY_JWT_ALGORITHM=HS256
# 限流：0=关闭（默认）；>0 时按「令牌哈希（无则客户端 IP）+ 固定窗口」计数，超限 429
TESTPLATFORM_SECURITY_RATE_LIMIT_PER_MINUTE=0
TESTPLATFORM_SECURITY_RATE_LIMIT_WINDOW_SECONDS=60

# ---- Frontend（CORS 白名单，默认空 = 不挂中间件）----
# 前端做时填来源，如 TESTPLATFORM_FRONTEND_CORS_ORIGINS=["http://localhost:5173"]
